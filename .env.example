# Copy to .env and fill in. Never commit .env.

# LLM mode:
#   fake   - deterministic offline heuristics, no API key needed (default; good for a first look)
#   replay - serve only from data/fixtures/llm_cache (raises a clear error on cache miss)
#   record - call OpenAI and write the cache (used by `make warm-cache`)
#   live   - call OpenAI, no cache
LLM_MODE=replay

OPENAI_API_KEY=
# Chosen by docs/MODEL_EVAL.md (cheapest model passing the bake-off). Re-check names/prices before use.
OPENAI_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model's dimension (requested via the `dimensions` parameter).
EMBEDDING_DIM=1536
# Hard cap on cumulative live spend (USD, from llm_calls). Live calls raise BudgetExceeded above it.
LLM_BUDGET_USD=5.00
# Optional price override (USD per 1M tokens), e.g. {"gpt-6-luna": {"input": 0.1, "cached": 0.01, "output": 0.5}}
LLM_PRICES_JSON=

RAW_SAMPLES=3
MAX_UPLOAD_MB=15
# Future work: redact PII before sending documents to OpenAI. Not implemented yet; keep false.
LLM_REDACT_PII=false

POSTGRES_PASSWORD=calibr
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000
