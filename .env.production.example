# Production configuration (example values only — never commit real secrets).
# Backend (Render web service; render.yaml sets most of these) ---------------------------------------------
APP_ENV=production
LLM_MODE=live                              # required in production; fake/replay refuse to start
DATABASE_URL=postgresql://user:password@host:5432/calibr   # postgres:// and postgresql:// are accepted
SESSION_SECRET=change-me-at-least-32-characters-long-random
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna                    # fixed by the operator; users cannot change it
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_REASONING_EFFORT=none
LLM_BUDGET_USD=3.00                        # hard cap on total live spend (sum of llm_calls.cost_usd)
USER_DAILY_USD_CAP=0.50                    # per-user daily AI spend; admins can lower it per user
USER_HOURLY_REQUESTS=60
MAX_CONCURRENT_RUNS_PER_USER=2
ADMIN_EMAIL=you@example.com                # first admin; becomes the owner of the seeded archive
ADMIN_PASSWORD=a-long-unique-password      # 10+ characters; only used to create/reset the admin at boot
AUTH_MODE=quick                            # quick = name-only sign-in for members; password = full accounts
SIGNUP_MODE=closed                         # open | invite | closed (password sign-up; unused in quick mode)
# INVITE_CODE=...                          # required (8+ chars) only when SIGNUP_MODE=invite
PUBLIC_APP_URL=https://project-calibrate.vercel.app
CORS_ORIGINS=https://project-calibrate.vercel.app
SEED_ARCHIVE=true                          # load deploy/seed/admin_archive.sql.gz once, into an empty database
USD_VND_RATE_DEFAULT=25869                 # VND per USD until the first refresh / manual edit
FX_AUTO_UPDATE=true                        # refresh daily from open.er-api.com (attribution shown in the UI)
LOG_LEVEL=INFO
# COOKIE_SECURE defaults to true in production.

# Frontend (Vercel project settings → Environment Variables) ------------------------------------------------
BACKEND_URL=https://project-calibrate-api.onrender.com   # target of the same-site /api/* rewrite (build time)
PUBLIC_APP_URL=https://project-calibrate.vercel.app
ROBOTS_INDEX=false                         # set true to allow search engines to index / and /help
